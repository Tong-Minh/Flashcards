{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Flashcards",
  "version": "../package.json",
  "identifier": "com.tongminh.flashcards",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev:desktop",
    "beforeBuildCommand": "npm run build:desktop"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Flashcards",
        "width": 1280,
        "height": 840,
        "minWidth": 1024,
        "minHeight": 640,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU3RTQ5NzVDRDg0NzFENzMKUldSekhVZllYSmZrNTNTclpWYnZVNUU1dGhmNUZRMDQvVTBkVUhHMmdJUng3Vm9rUEdPVlA2MFgK",
      "endpoints": [
        "https://github.com/Tong-Minh/Flashcards/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
